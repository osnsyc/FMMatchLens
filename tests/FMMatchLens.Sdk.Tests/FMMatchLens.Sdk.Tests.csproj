<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Linked capture buffers are assigned by native capture only in the host build. -->
    <NoWarn>$(NoWarn);0649</NoWarn>
    <PackageId>FMMatchLens.Sdk.Tests</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="../../src/FMMatchLens.Contracts/FMMatchLens.Contracts.csproj" />
    <!-- Compile the real managed sources; no Unity stubs or alternate SDK implementation. -->
    <Compile Include="../../src/FMMatchLens.Plugin/Sdk/*.cs" Exclude="../../src/FMMatchLens.Plugin/Sdk/SdkUpdatePump.cs" Link="Sdk/%(Filename)%(Extension)" />
    <Compile Include="../../src/FMMatchLens.Plugin/Domain/*.cs" Link="Domain/%(Filename)%(Extension)" />
    <Compile Include="../../src/FMMatchLens.Plugin/Memory/RealtimeTickFrameBuffer.cs" Link="Source/RealtimeTickFrameBuffer.cs" />
    <Compile Include="../../src/FMMatchLens.Plugin/Memory/Offsets.cs" Link="Source/Offsets.cs" />
    <Compile Include="../../src/FMMatchLens.Plugin/Services/Archive*.cs" Link="Source/%(Filename)%(Extension)" />
    <Compile Include="../../src/FMMatchLens.Plugin/Services/MatchArchiveStore.cs" Link="Source/MatchArchiveStore.cs" />
    <Compile Include="../../src/FMMatchLens.Plugin/Services/RealtimeMatchTimeline.cs" Link="Source/RealtimeMatchTimeline.cs" />
    <Compile Include="../../src/FMMatchLens.Plugin/Services/MomentumEventReconciler.cs" Link="Source/MomentumEventReconciler.cs" />
    <Compile Include="../../src/FMMatchLens.Plugin/Services/GraphicsAssetIndex.cs" Link="Source/GraphicsAssetIndex.cs" />
  </ItemGroup>
</Project>
