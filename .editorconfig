root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

[*.{cs,csproj,props,ps1}]
end_of_line = crlf

[*.{json,md,ts,tsx,yml,yaml}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
